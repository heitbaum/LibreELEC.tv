[Unit]
Description=WS-Discovery Host
BindsTo=smbd.service
After=network-online.target smbd.service
Wants=network-online.target
ConditionPathExists=/run/samba/smb.conf

[Service]
Type=notify
ExecStart=/usr/sbin/wsddn --systemd --smb-conf=/run/samba/smb.conf
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
DynamicUser=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
