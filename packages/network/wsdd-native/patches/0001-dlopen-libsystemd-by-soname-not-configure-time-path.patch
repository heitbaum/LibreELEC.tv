From fdb9995dc885886d918d05d4255aaabd1bacad6a Mon Sep 17 00:00:00 2001
From: Rudi Heitbaum <rudi@heitbaum.com>
Date: Sun, 2 Aug 2026 16:53:20 +1000
Subject: [PATCH] dlopen libsystemd by soname not configure-time path

find_library() records an absolute path, which is then compiled into the
binary as the dlopen() argument. That path is only correct when the build
and the run time filesystem are the same one - a cross compiled binary
gets the sysroot copy, which does not exist on the target, so the daemon
exits when started with --systemd.

Use the file name alone and let the runtime loader resolve it.
---
 cmake/detect_system.cmake | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/cmake/detect_system.cmake b/cmake/detect_system.cmake
index ce797fc..5b007ab 100755
--- a/cmake/detect_system.cmake
+++ b/cmake/detect_system.cmake
@@ -171,6 +171,11 @@ if (WSDDN_WITH_SYSTEMD STREQUAL "yes" OR WSDDN_WITH_SYSTEMD STREQUAL "auto" AND
             set(LIBSYSTEMD_SO "${LIBSYSTEMD_LIBRARY}")
         endif()
 
+        # dlopen() resolves a bare soname through the runtime loader search
+        # path. Recording the configure-time path breaks cross compilation,
+        # where it names a sysroot copy that does not exist on the target.
+        get_filename_component(LIBSYSTEMD_SO "${LIBSYSTEMD_SO}" NAME)
+
         set(LIBSYSTEMD_SO "${LIBSYSTEMD_SO}"  CACHE INTERNAL "" FORCE)
     endif()
 
