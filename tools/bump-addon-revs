# Scan a commit range for addon-depends updates and increment PKG_REV of each
# dependent addon package (once per addon, with a body listing all triggers).
#
# Usage: tools/bump-addon-revs [commit-range]
#   commit-range defaults to all commits on the current branch not yet on master.
#
# Example: tools/bump-addon-revs master..HEAD

set -euo pipefail

RANGE="${1:-$(git merge-base HEAD master)..HEAD}"

declare -A dep_msgs=()   # dep_pkgname -> newline-separated commit subjects
declare -A dep_pkgmk=()  # dep_pkgname -> path to its package.mk

# Emit the bundled target-dependency tokens of a package.mk: the values of
# PKG_DEPENDS_TARGET / PKG_ADDON_REQUIRES with line-continuations joined and
# ':host' build-only tools dropped. An addon only bundles - and so is only
# rebuilt by - a package listed here, so host tooling (cmake:host) and
# packages named only in hooks/comments (e.g. the patchelf command) are
# correctly excluded and never trigger a spurious rev bump.
addon_target_deps() {
  awk '
    {
      line = $0
      if (line ~ /\\[[:space:]]*$/) { sub(/\\[[:space:]]*$/, "", line); buf = buf line " "; next }
      buf = buf line
      if (buf ~ /^[[:space:]]*(PKG_DEPENDS_TARGET|PKG_ADDON_REQUIRES)[[:space:]]*\+?=/) {
        sub(/^[^=]*=/, "", buf)
        gsub(/"/, "", buf)
        n = split(buf, t, /[[:space:]]+/)
        for (i = 1; i <= n; i++)
          if (t[i] != "" && t[i] !~ /:host$/) print t[i]
      }
      buf = ""
    }
  ' "${1}"
}

while IFS= read -r commit; do
  subject=$(git log --format="%s" -1 "${commit}")

  while IFS= read -r file; do
    [[ "${file}" == packages/*/package.mk ]] || continue
    # Skip addon packages themselves; addon-depends and all other packages are in scope
    [[ "${file}" == packages/addons/* && "${file}" != packages/addons/addon-depends/* ]] && continue

    # Only act on commits that change PKG_VERSION= (not SPDX fixes, patches, etc.).
    git diff "${commit}^" "${commit}" -- "${file}" 2>/dev/null \
      | grep -q "^[-+]PKG_VERSION=" || continue

    pkgname=$(basename "$(dirname "${file}")")

    while IFS= read -r d_pkgmk; do
      [ -z "${d_pkgmk}" ] && continue
      # Only bump addons that actually bundle this package as a target
      # dependency - skip host build tools (cmake:host etc.) and packages
      # merely referenced in hooks/comments (e.g. the patchelf command).
      addon_target_deps "${d_pkgmk}" | grep -qxF "${pkgname}" || continue
      d_pkgname=$(basename "$(dirname "${d_pkgmk}")")
      d_rev=$(grep "^PKG_REV=" "${d_pkgmk}" | sed 's/PKG_REV="//;s/"//')
      [ -z "${d_rev}" ] && continue
      # Skip if this subject is already recorded for this dependent.
      [[ "${dep_msgs[${d_pkgname}]:-}" == *"${subject}"* ]] && continue
      dep_msgs[${d_pkgname}]+="${subject}"$'\n'
      dep_pkgmk[${d_pkgname}]="${d_pkgmk}"
    done < <(find packages/addons packages/mediacenter/kodi-binary-addons -type f -name "package.mk" \
      -not -path "packages/addons/addon-depends/*" \
      | xargs grep -wl "${pkgname}" 2>/dev/null)
  done < <(git diff-tree --no-commit-id -r --name-only "${commit}")
done < <(git log --reverse --format="%H" "${RANGE}")

if [ ${#dep_msgs[@]} -eq 0 ]; then
  echo "No package updates with dependent addons found in range: ${RANGE}"
  exit 0
fi

for d_pkgname in "${!dep_msgs[@]}"; do
  d_pkgmk_path="${dep_pkgmk[${d_pkgname}]}"

  # Skip if the dependent addon was already increment in this range.
  if git log --quiet --format="%H" "${RANGE}" -- "${d_pkgmk_path}" | grep -q .; then
    echo "skip ${d_pkgname}: already updated in range"
    continue
  fi

  old_rev=$(grep "^PKG_REV=" "${d_pkgmk_path}" | sed 's/PKG_REV="//;s/"//')
  new_rev=$(( old_rev + 1 ))
  sed -e "s|^PKG_REV=.*|PKG_REV=\"${new_rev}\"|" -i "${d_pkgmk_path}"

  commit_msg="${d_pkgname}: update addon (${new_rev})"$'\n'
  while IFS= read -r line; do
    [ -z "${line}" ] && continue
    commit_msg+=$'\n'"- ${line}"
  done <<< "${dep_msgs[${d_pkgname}]}"

  printf "%s" "${commit_msg}" | git commit -F - "${d_pkgmk_path}"
  echo "update ${d_pkgname} addon (${new_rev})"
done
