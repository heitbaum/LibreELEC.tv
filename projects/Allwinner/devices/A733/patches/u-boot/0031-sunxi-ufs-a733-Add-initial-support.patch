+void sunxi_soc_ext_res(void)
+{
+	writel(readl(RESCAL_CTRL_REG) | (0x1 << 13), RESCAL_CTRL_REG);//use EXT Res200
+	writel(readl(RES1_CTRL_REG) & ~(0xFF << 24), RES1_CTRL_REG);
+}
