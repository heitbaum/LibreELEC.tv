+static int ufshcd_dwc_link_is_up(struct ufs_hba *hba)
+{
+	u32 dme_result = 0;
+
+	ufshcd_dme_get(hba, UIC_ARG_MIB(VS_POWERSTATE), &dme_result);
+
+	if (dme_result == UFSHCD_LINK_IS_UP) {
+		/*ufshcd_set_link_active(hba);*/
+		return 0;
+	}
+
+	return 1;
+}
