From 1a3a2a03c7b5e277684662189cdf1e08d1d45a22 Mon Sep 17 00:00:00 2001
From: Yixun Lan <dlan@gentoo.org>
Date: Wed, 27 Aug 2025 15:49:31 +0000
Subject: [PATCH 16/33] config: usb: enable gadget & fastboot/dfu support

Signed-off-by: Yixun Lan <dlan@gentoo.org>
---
 configs/radxa-cubie-a7a_defconfig | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/configs/radxa-cubie-a7a_defconfig b/configs/radxa-cubie-a7a_defconfig
index 751664db245..477dba50e60 100644
--- a/configs/radxa-cubie-a7a_defconfig
+++ b/configs/radxa-cubie-a7a_defconfig
@@ -10,9 +10,14 @@ CONFIG_MMC_SUNXI_SLOT_EXTRA=2
 CONFIG_SPL_LOAD_FIT_ADDRESS=0x4D000000
 CONFIG_BOOTDELAY=3
 CONFIG_SPL_RAM_DEVICE=y
+CONFIG_CMD_DFU=y
 CONFIG_CMD_I2C=y
 CONFIG_NET_RANDOM_ETHADDR=y
 CONFIG_SYS_I2C_MVTWSI=y
 CONFIG_SUPPORT_EMMC_BOOT=y
 CONFIG_REGULATOR_AXP=y
 # CONFIG_SYSRESET is not set
+CONFIG_USB_EHCI_HCD=y
+CONFIG_USB_OHCI_HCD=y
+CONFIG_USB_MUSB_GADGET=y
+CONFIG_USB_ETH_CDC=y
-- 
