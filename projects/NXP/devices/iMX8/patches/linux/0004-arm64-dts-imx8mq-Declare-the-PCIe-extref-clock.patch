diff --git a/newpatches/0003-PCI-imx6-Select-the-PCIe-REF_CLK-source-on-i.MX8MQ.patch b/newpatches/0003-PCI-imx6-Select-the-PCIe-REF_CLK-source-on-i.MX8MQ.patch
new file mode 100644
index 0000000..8058460
