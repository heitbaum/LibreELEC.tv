++++ 		return dev_err_probe(dev, imx_pcie->num_clks,
++++ 				     "failed to get clocks\n");
++++ 	for (i = 0; i < imx_pcie->num_clks; i++)
++++-		if (strncmp(imx_pcie->clks[i].id, "extref", 6) == 0)
