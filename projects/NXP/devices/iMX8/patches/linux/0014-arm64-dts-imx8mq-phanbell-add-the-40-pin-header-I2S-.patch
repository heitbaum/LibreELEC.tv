From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Rudi Heitbaum <rudi@heitbaum.com>
Date: Mon, 3 Aug 2026 00:41:53 +1000
Subject: [PATCH] arm64: dts: imx8mq-phanbell: add the 40-pin header I2S card

SAI1 goes to the 40-pin expansion header as plain I2S with no codec on
the far side, which the vendor kernel exposes as its "40-pin Header"
card.

Use linux,spdif-dit as the far end. The vendor uses a
linux,snd-soc-dummy node, but that compatible does not exist upstream -
sound/soc/soc-utils.c creates the dummy as a faux device with no
of_match_table, so a devicetree node naming it never binds and the card
cannot resolve its codec. spdif-dit is the usual stand-in and is already
enabled here.

One difference from the vendor as a result: spdif-dit is a transmitter,
so this card is playback only, where the vendor's dummy gave both
directions.

Signed-off-by: Rudi Heitbaum <rudi@heitbaum.com>
---
 .../boot/dts/freescale/imx8mq-phanbell.dts    | 46 +++++++++++++++++++
 1 file changed, 46 insertions(+)

diff --git a/arch/arm64/boot/dts/freescale/imx8mq-phanbell.dts b/arch/arm64/boot/dts/freescale/imx8mq-phanbell.dts
index 2b8d18d310d6..4be1ac23ef88 100644
--- a/arch/arm64/boot/dts/freescale/imx8mq-phanbell.dts
+++ b/arch/arm64/boot/dts/freescale/imx8mq-phanbell.dts
@@ -21,6 +21,32 @@ memory@40000000 {
 		reg = <0x00000000 0x40000000 0 0x40000000>;
 	};
 
+	header_codec: spdif-transmitter {
+		compatible = "linux,spdif-dit";
+		#sound-dai-cells = <0>;
+	};
+
+	sound-header {
+		compatible = "simple-audio-card";
+		simple-audio-card,name = "40-pin Header";
+		simple-audio-card,format = "i2s";
+
+		/*
+		 * 32 bit slots regardless of the sample width. sai1 divides
+		 * its 24.576 MHz root by an even integer only, so a 24 bit
+		 * frame at 48 kHz would ask for a ratio of 10.67 and fail.
+		 */
+		simple-audio-card,cpu {
+			sound-dai = <&sai1>;
+			dai-tdm-slot-num = <2>;
+			dai-tdm-slot-width = <32>;
+		};
+
+		simple-audio-card,codec {
+			sound-dai = <&header_codec>;
+		};
+	};
+
 	sound-analog {
 		compatible = "simple-audio-card";
 		simple-audio-card,name = "Coral Analog";
@@ -332,6 +358,16 @@ rt5645: audio-codec@1a {
 	};
 };
 
+&sai1 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&pinctrl_sai1>;
+	assigned-clocks = <&clk IMX8MQ_CLK_SAI1>;
+	assigned-clock-parents = <&clk IMX8MQ_AUDIO_PLL1_OUT>;
+	assigned-clock-rates = <24576000>;
+	fsl,sai-mclk-direction-output;
+	status = "okay";
+};
+
 &sai2 {
 	pinctrl-names = "default";
 	pinctrl-0 = <&pinctrl_sai2>;
@@ -686,6 +722,16 @@ MX8MQ_IOMUXC_NAND_DATA05_GPIO3_IO11		0x16
 		>;
 	};
 
+	pinctrl_sai1: sai1grp {
+		fsl,pins = <
+			MX8MQ_IOMUXC_SAI1_MCLK_SAI1_MCLK	0xd6
+			MX8MQ_IOMUXC_SAI1_TXFS_SAI1_TX_SYNC	0xd6
+			MX8MQ_IOMUXC_SAI1_TXC_SAI1_TX_BCLK	0xd6
+			MX8MQ_IOMUXC_SAI1_TXD0_SAI1_TX_DATA0	0xd6
+			MX8MQ_IOMUXC_SAI1_RXD0_SAI1_RX_DATA0	0xd6
+		>;
+	};
+
 	pinctrl_sai2: sai2grp {
 		fsl,pins = <
 			MX8MQ_IOMUXC_SAI2_MCLK_SAI2_MCLK	0xd6
-- 
2.47.1

