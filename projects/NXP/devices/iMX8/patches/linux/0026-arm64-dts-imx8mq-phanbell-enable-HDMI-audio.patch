From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Rudi Heitbaum <rudi@heitbaum.com>
Date: Mon, 3 Aug 2026 14:37:04 +1000
Subject: [PATCH 26/26] arm64: dts: imx8mq-phanbell: enable HDMI audio

sai4 is wired to the HDMI transmitter inside the SoC, so it needs no
pinmux, only a root clock. Point a simple-audio-card at it and at the
hdmi-codec the MHDP8501 bridge now registers.

#sound-dai-cells belongs on the bridge itself, so it goes in the SoC
dtsi. The codec is a platform device with no devicetree node of its
own, but the ASoC core falls back to the parent's node when matching a
sound-dai phandle, and the parent is the bridge.

The root clock is the same 24.576 MHz from AUDIO_PLL1 that sai2 uses
for the analog card, which covers the 48 kHz family.
---
 .../boot/dts/freescale/imx8mq-phanbell.dts    | 24 +++++++++++++++++++
 arch/arm64/boot/dts/freescale/imx8mq.dtsi     |  1 +
 2 files changed, 25 insertions(+)

diff --git a/arch/arm64/boot/dts/freescale/imx8mq-phanbell.dts b/arch/arm64/boot/dts/freescale/imx8mq-phanbell.dts
index 2706e58..0b46ac9 100644
--- a/arch/arm64/boot/dts/freescale/imx8mq-phanbell.dts
+++ b/arch/arm64/boot/dts/freescale/imx8mq-phanbell.dts
@@ -67,6 +67,22 @@ simple-audio-card,codec {
 		};
 	};
 
+	sound-hdmi {
+		compatible = "simple-audio-card";
+		simple-audio-card,name = "Coral HDMI";
+		simple-audio-card,format = "i2s";
+		simple-audio-card,bitclock-master = <&sound_hdmi_cpu>;
+		simple-audio-card,frame-master = <&sound_hdmi_cpu>;
+
+		sound_hdmi_cpu: simple-audio-card,cpu {
+			sound-dai = <&sai4>;
+		};
+
+		simple-audio-card,codec {
+			sound-dai = <&mhdp>;
+		};
+	};
+
 	busfreq {
 		status = "disabled";
 	};
@@ -409,6 +425,14 @@ &sai2 {
 	status = "okay";
 };
 
+/* sai4 is wired to the HDMI transmitter inside the SoC, so it has no pinmux */
+&sai4 {
+	assigned-clocks = <&clk IMX8MQ_CLK_SAI4>;
+	assigned-clock-parents = <&clk IMX8MQ_AUDIO_PLL1_OUT>;
+	assigned-clock-rates = <24576000>;
+	status = "okay";
+};
+
 &pcie0 {
 	pinctrl-names = "default";
 	pinctrl-0 = <&pinctrl_pcie0>;
diff --git a/arch/arm64/boot/dts/freescale/imx8mq.dtsi b/arch/arm64/boot/dts/freescale/imx8mq.dtsi
index b28840d..5fbdf4c 100644
--- a/arch/arm64/boot/dts/freescale/imx8mq.dtsi
+++ b/arch/arm64/boot/dts/freescale/imx8mq.dtsi
@@ -1614,6 +1614,7 @@ mhdp: bridge@32c00000 {
 				interrupt-names = "plug_in", "plug_out";
 				clocks = <&clk IMX8MQ_CLK_DISP_APB_ROOT>;
 				phys = <&mdhp_phy>;
+				#sound-dai-cells = <0>;
 				status = "disabled";
 
 				ports {
-- 
