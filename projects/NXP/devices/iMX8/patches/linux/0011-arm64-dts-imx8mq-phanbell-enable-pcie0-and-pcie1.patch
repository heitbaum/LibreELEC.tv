From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Rudi Heitbaum <rudi@heitbaum.com>
Date: Mon, 3 Aug 2026 22:30:00 +1000
Subject: [PATCH] arm64: dts: imx8mq-phanbell: enable pcie0 and pcie1

pcie0 carries an Atheros QCA6174 and pcie1 an Edge TPU. They take their
reference clocks from opposite places, which is most of the work here.

pcie0 uses the internal PLL, so the SoC has to drive the 100 MHz
reference out to the endpoint itself on CLK2_P/N. That output is the
pllout_monitor_clk2 gate, so the node holds a reference on it to keep
clk_disable_unused() off it and sets the mux and divider feeding it. The
three pcie1_* assignments repeat what imx8mq.dtsi already sets, because
setting the property here replaces it rather than adding to it.

pcie1 takes an off-chip oscillator on the pad, named as its extref clock.

wl-reg-on is hogged high because it is the QCA6174's enable, and the
Bluetooth side of that combo part needs it as much as the radio does.
---
 .../boot/dts/freescale/imx8mq-phanbell.dts    | 93 +++++++++++++++++++
 1 file changed, 93 insertions(+)

diff --git a/arch/arm64/boot/dts/freescale/imx8mq-phanbell.dts b/arch/arm64/boot/dts/freescale/imx8mq-phanbell.dts
index b8e61c7ab8d5..24c70cd76b0d 100644
--- a/arch/arm64/boot/dts/freescale/imx8mq-phanbell.dts
+++ b/arch/arm64/boot/dts/freescale/imx8mq-phanbell.dts
@@ -103,6 +103,12 @@ fan: gpio-fan {
 		pinctrl-0 = <&pinctrl_gpio_fan>;
 		status = "okay";
 	};
+
+	pcie1_refclk: pcie1-refclk {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <100000000>;
+	};
 };
 
 &A53_0 {
@@ -168,6 +174,17 @@ map4 {
 	};
 };
 
+&gpio3 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&pinctrl_wifi_reset>;
+
+	wl-reg-on {
+		gpio-hog;
+		gpios = <11 GPIO_ACTIVE_HIGH>;
+		output-high;
+	};
+};
+
 &i2c1 {
 	clock-frequency = <400000>;
 	pinctrl-names = "default";
@@ -364,6 +381,62 @@ &sai2 {
 	status = "okay";
 };
 
+&pcie0 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&pinctrl_pcie0>;
+	reset-gpio = <&gpio3 10 GPIO_ACTIVE_LOW>;
+	vph-supply = <&ldo7>;
+	/*
+	 * pcie0 takes REF_CLK from the internal PLL, and the SoC drives the
+	 * 100 MHz reference out to the endpoint on CLK2_P/N. That output is
+	 * the pllout_monitor_clk2 gate; hold a reference on it here so
+	 * clk_disable_unused() cannot switch the endpoint's clock off, and
+	 * set the mux and divider that feed it below.
+	 */
+	clocks = <&clk IMX8MQ_CLK_PCIE1_ROOT>,
+		 <&clk IMX8MQ_CLK_MON_CLK2_OUT>,
+		 <&clk IMX8MQ_CLK_PCIE1_PHY>,
+		 <&clk IMX8MQ_CLK_PCIE1_AUX>;
+	/*
+	 * The first three repeat what imx8mq.dtsi already assigns for this
+	 * controller, because setting the property here replaces it rather
+	 * than adding to it. The last two point the monitor mux at
+	 * sys_pll1_out_monitor and divide its 800 MHz down to the 100 MHz
+	 * the endpoint needs.
+	 */
+	assigned-clocks = <&clk IMX8MQ_CLK_PCIE1_CTRL>,
+			  <&clk IMX8MQ_CLK_PCIE1_PHY>,
+			  <&clk IMX8MQ_CLK_PCIE1_AUX>,
+			  <&clk IMX8MQ_CLK_MON_SEL>,
+			  <&clk IMX8MQ_CLK_MON_SYS_PLL1_DIV>;
+	assigned-clock-parents = <&clk IMX8MQ_SYS2_PLL_250M>,
+				 <&clk IMX8MQ_SYS2_PLL_100M>,
+				 <&clk IMX8MQ_SYS1_PLL_80M>,
+				 <&clk IMX8MQ_CLK_MON_SYS_PLL1_DIV>;
+	assigned-clock-rates = <250000000>, <100000000>, <10000000>,
+				       <0>, <100000000>;
+	fsl,max-link-speed = <1>;
+	hard-wired = <1>;
+	supports-clkreq;
+	status = "okay";
+};
+
+&pcie1 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&pinctrl_pcie1>;
+	reset-gpio = <&gpio3 18 GPIO_ACTIVE_LOW>;
+	vph-supply = <&ldo7>;
+	clocks = <&clk IMX8MQ_CLK_PCIE2_ROOT>,
+		 <&pcie1_refclk>,
+		 <&clk IMX8MQ_CLK_PCIE2_PHY>,
+		 <&clk IMX8MQ_CLK_PCIE2_AUX>,
+		 <&pcie1_refclk>;
+	clock-names = "pcie", "pcie_bus", "pcie_phy", "pcie_aux", "extref";
+	hard-wired = <1>;
+	supports-clkreq;
+	status = "okay";
+};
+
 &ecspi1 {
 	pinctrl-names = "default";
 	pinctrl-0 = <&pinctrl_ecspi1 &pinctrl_ecspi1_cs>;
@@ -478,6 +551,20 @@ MX8MQ_IOMUXC_ECSPI2_SS0_GPIO5_IO13		0x19
 		>;
 	};
 
+	pinctrl_pcie0: pcie0grp {
+		fsl,pins = <
+			MX8MQ_IOMUXC_I2C4_SCL_PCIE1_CLKREQ_B		0x76
+			MX8MQ_IOMUXC_NAND_DATA04_GPIO3_IO10		0x16
+		>;
+	};
+
+	pinctrl_pcie1: pcie1grp {
+		fsl,pins = <
+			MX8MQ_IOMUXC_I2C4_SDA_PCIE2_CLKREQ_B		0x76
+			MX8MQ_IOMUXC_NAND_WP_B_GPIO3_IO18		0x19
+		>;
+	};
+
 	pinctrl_ecspi1: ecspi1grp {
 		fsl,pins = <
 			MX8MQ_IOMUXC_ECSPI1_SCLK_ECSPI1_SCLK		0x82
@@ -659,6 +746,12 @@ MX8MQ_IOMUXC_GPIO1_IO02_WDOG1_WDOG_B 0xc6
 		>;
 	};
 
+	pinctrl_wifi_reset: wifiresetgrp {
+		fsl,pins = <
+			MX8MQ_IOMUXC_NAND_DATA05_GPIO3_IO11		0x16
+		>;
+	};
+
 	pinctrl_sai1: sai1grp {
 		fsl,pins = <
 			MX8MQ_IOMUXC_SAI1_MCLK_SAI1_MCLK	0xd6
-- 
2.47.1

