# Atheros QCA6174 (168c:003e) on the Coral Dev Board, reached over pcie0.
# The part reports no subsystem ids, so board-2.bin cannot match it and
# ath10k falls back to the generic board.bin - keep the whole directory
# rather than guessing which files the driver will ask for.
ath10k/QCA6174/hw3.0/*

# QCA6174 bluetooth, the other half of the same combo part, on uart2.
# btqca builds the names from the SoC version it reads out of the chip
# (btqca.c:850,944 - "qca/rampatch_%08x.bin" and "qca/nvm_%08x.bin").
# The vendor rootfs pins that down: its legacy rampatch_tlv_3.2.tlv is a
# symlink to qca/rampatch_00130302.bin, so this module is 00130302.
qca/*00130302.bin
